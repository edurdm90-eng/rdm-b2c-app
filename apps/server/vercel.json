{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/trpc/:path*", "destination": "/api/trpc/:path*" }
  ]
}
