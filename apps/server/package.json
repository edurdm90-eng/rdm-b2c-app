{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test ../../packages/api/src/domain/rdm.test.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/trpc-server": "^0.4.2",
    "@rdm-b2c/api": "workspace:*",
    "@rdm-b2c/auth": "workspace:*",
    "@rdm-b2c/db": "workspace:*",
    "@rdm-b2c/env": "workspace:*",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rdm-b2c/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
