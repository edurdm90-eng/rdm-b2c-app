# Copy to apps/server/.env and fill in your own local values. Never commit secrets.
DATABASE_URL=mongodb://127.0.0.1:27017/rdm-business
# Optional. Keep this low for serverless deployments; each warm instance owns a pool.
MONGODB_MAX_POOL_SIZE=10
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8081
# Create a Web OAuth client in Google Cloud and configure its redirect URI as
# http://localhost:3000/api/auth/callback/google locally, then add the
# production Better Auth URL equivalent in Google Cloud before deploying.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Temporary compatibility window for APKs released before target-index validation.
LEGACY_FOCUS_TAP_CUTOFF=2026-10-25T00:00:00.000Z
PORT=3000
NODE_ENV=development

# Optional: the rest of the app runs without a key; Medaa Ai explains unavailability.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MEDAA_DAILY_REQUEST_LIMIT=30
